<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="{{ settings.color_background }}">
    <link rel="canonical" href="{{ canonical_url }}">
    <title>{{ page_title }}{% if current_tags %} – {{ current_tags | join: ', ' }}{% endif %}{% if current_page != 1 %} – Page {{ current_page }}{% endif %}{% unless page_title contains shop.name %} – {{ shop.name }}{% endunless %}</title>
    {% if page_description %}<meta name="description" content="{{ page_description | escape }}">{% endif %}
    {{ content_for_header }}
    <style>
      :root { --page-width: 1440px; --color-text: {{ settings.color_text }}; --color-background: {{ settings.color_background }}; --color-accent: {{ settings.color_accent }}; }
      * { box-sizing: border-box; }
      body { margin: 0; color: var(--color-text); background: var(--color-background); font-family: Arial, Helvetica, sans-serif; }
      a { color: inherit; }
      img { max-width: 100%; height: auto; }
      .page-width { width: min(calc(100% - 40px), var(--page-width)); margin-inline: auto; }
      .button { display: inline-flex; align-items: center; justify-content: center; padding: 14px 22px; background: var(--color-accent); color: #fff; text-decoration: none; border: 0; border-radius: 3px; font: inherit; cursor: pointer; }
    </style>
  </head>
  <body>
    {% sections 'header-group' %}
    <main id="MainContent" role="main">{{ content_for_layout }}</main>
    {% sections 'footer-group' %}
  </body>
</html>
