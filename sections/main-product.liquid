<style>
.product-page{padding-top:clamp(32px,5vw,68px);padding-bottom:80px;display:grid;grid-template-columns:minmax(0,1.1fr) minmax(320px,.9fr);gap:clamp(28px,5vw,72px);align-items:start;color:#111}
.product-gallery{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}
.product-gallery__item{min-width:0;display:flex;align-items:center;justify-content:center;background:#fff;overflow:hidden;min-height:0}
.product-gallery__item--wide{grid-column:1/-1}
.product-gallery__item img,.product-gallery__item video,.product-gallery__item iframe,.product-gallery__item model-viewer{display:block;width:100%;max-height:680px;object-fit:contain}
.product-info{position:sticky;top:35px;color:#111}
.product-info__vendor{color:#2563eb;font-size:10px;letter-spacing:.18em;text-transform:uppercase;font-weight:700}
.product-info h1{color:#111;font:400 clamp(34px,4.5vw,58px)/1.03 Georgia,serif;letter-spacing:-.05em;margin:14px 0}
.product-info__price{display:inline-block;font-size:22px;font-weight:800;line-height:1.25;color:#111;margin:12px 0 20px}
.product-info__description{color:#333;font-size:14px;line-height:1.8;margin:22px 0}
.product-info__form{display:grid;gap:14px}
.product-info__form label{color:#111;font-size:13px;font-weight:700}
.product-info__form select,.product-info__form input{width:100%;background:#fff;color:#111;border:1px solid #cbd5e1;border-radius:7px;padding:14px}
.product-info__form select option{color:#111;background:#fff}
.product-info__form button{width:100%;min-height:50px}
.product-info__form button:disabled{opacity:.45;cursor:not-allowed}
.product-info__note{font-size:12px;color:#475569;margin-top:14px}
@media(max-width:800px){.product-page{grid-template-columns:1fr;gap:24px;padding-top:22px;padding-bottom:55px}.product-info{position:static}.product-gallery{gap:8px}.product-gallery__item img,.product-gallery__item video,.product-gallery__item iframe,.product-gallery__item model-viewer{max-height:340px}.product-info h1{font-size:34px;margin:10px 0}.product-info__price{font-size:22px;margin:8px 0 14px}}
@media(max-width:480px){.product-gallery{grid-template-columns:repeat(2,minmax(0,1fr))}.product-gallery__item img,.product-gallery__item video,.product-gallery__item iframe,.product-gallery__item model-viewer{max-height:230px}.product-gallery__item--wide img,.product-gallery__item--wide video,.product-gallery__item--wide iframe{max-height:280px}}
</style>
<section class="page-width product-page">
 <div class="product-gallery">
  {% assign has_video = false %}
  {% for media in product.media %}{% if media.media_type == 'video' or media.media_type == 'external_video' %}{% assign has_video = true %}{% endif %}{% endfor %}
  {% for media in product.media %}
   {% if media.media_type == 'video' or media.media_type == 'external_video' %}
    <div class="product-gallery__item {% if has_video and forloop.first %}product-gallery__item--wide{% endif %}">
     {% if media.media_type == 'video' %}{{ media | media_tag: controls: true, preload: 'metadata' }}{% else %}{{ media | external_video_tag }}{% endif %}
    </div>
   {% endif %}
  {% endfor %}
  {% for media in product.media %}
   {% unless media.media_type == 'video' or media.media_type == 'external_video' %}
    <div class="product-gallery__item">{% if media.media_type == 'image' %}{{ media | image_url: width: 1200 | image_tag: loading:'lazy', alt:media.alt | default:product.title }}{% else %}{{ media | media_tag }}{% endif %}</div>
   {% endunless %}
  {% endfor %}
 </div>
 <div class="product-info">
  {% if product.vendor != blank %}<p class="product-info__vendor">{{ product.vendor | escape }}</p>{% endif %}
  <h1>{{ product.title | escape }}</h1>
  <p class="product-info__price">{{ product.selected_or_first_available_variant.price | money }}</p>
  {% if product.description != blank %}<div class="product-info__description">{{ product.description }}</div>{% endif %}
  {% form 'product', product, class:'product-info__form' %}
   {% if product.has_only_default_variant == false %}
    <label for="ProductVariant-{{ section.id }}">Choose an option</label>
    <select id="ProductVariant-{{ section.id }}" name="id">
     {% for variant in product.variants %}<option value="{{ variant.id }}" {% if variant == product.selected_or_first_available_variant %}selected{% endif %} {% unless variant.available %}disabled{% endunless %}>{{ variant.title | escape }} · {{ variant.price | money }}{% unless variant.available %} · Sold out{% endunless %}</option>{% endfor %}
    </select>
   {% else %}<input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">{% endif %}
   <label for="Quantity-{{ section.id }}">Quantity</label><input id="Quantity-{{ section.id }}" type="number" name="quantity" value="1" min="1">
   <button class="button" type="submit" name="add" {% unless product.selected_or_first_available_variant.available %}disabled{% endunless %}>{% if product.selected_or_first_available_variant.available %}Add to cart{% else %}Sold out{% endif %}</button>
  {% endform %}
  <p class="product-info__note">Secure checkout · Carefully selected essentials</p>
 </div>
</section>
{% schema %}
{"name":"Product details","settings":[]}
{% endschema %}