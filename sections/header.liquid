<style>
.site-header{position:relative;z-index:10;border-bottom:1px solid rgba(245,248,241,.14);background:#082f25}
.site-header__top{min-height:82px;display:flex;align-items:center;justify-content:space-between;gap:24px}
.site-header__brand{color:#f5f8f1;font:26px Georgia,serif;letter-spacing:-.045em;text-decoration:none}
.site-header__cart{color:#c7e5b6;font-size:10px;letter-spacing:.15em;text-transform:uppercase;text-decoration:none;white-space:nowrap}
.site-header__nav-wrap{border-top:1px solid rgba(245,248,241,.1)}
.site-header__nav{display:flex;align-items:center;gap:27px;overflow-x:auto;scrollbar-width:none;padding:15px 0;white-space:nowrap}
.site-header__nav::-webkit-scrollbar{display:none}
.site-header__nav a{color:rgba(245,248,241,.78);font-size:10px;font-weight:600;letter-spacing:.11em;text-transform:uppercase;text-decoration:none;transition:color .2s}
.site-header__nav a:hover,.site-header__nav a[aria-current=page]{color:#c7e5b6}
@media(max-width:700px){.site-header__top{min-height:68px}.site-header__brand{font-size:23px}.site-header__nav{gap:22px;padding:13px 0}.site-header__nav a{font-size:9px}}
</style>
<header class="site-header">
 <div class="page-width site-header__top">
  <a class="site-header__brand" href="{{ routes.root_url }}">{{ shop.name }}</a>
  <a class="site-header__cart" href="{{ routes.cart_url }}">Bag ({{ cart.item_count }})</a>
 </div>
 <div class="site-header__nav-wrap">
  <nav class="page-width site-header__nav" aria-label="Shop categories">
   <a href="{{ routes.root_url }}">Home</a>
   <a href="{{ collections['new-arrivals'].url }}">New Arrivals</a>
   <a href="{{ collections['most-loved'].url }}">Most Loved</a>
   <a href="{{ collections['gaming-pcs-and-electronics'].url }}">Gaming PCs & Electronics</a>
   <a href="{{ collections['phones-and-accessories'].url }}">Phones & Accessories</a>
   <a href="{{ collections['womens'].url }}">Womens</a>
   <a href="{{ collections['men'].url }}">Men</a>
   <a href="{{ collections['kids-clothing'].url }}">Kids Clothing</a>
   <a href="{{ collections['kitchen-accessories'].url }}">Kitchen Accessories</a>
   <a href="{{ collections['bed-and-living-room'].url }}">Bed & Living Room</a>
   <a href="{{ collections['fancy-goods'].url }}">Fancy Goods</a>
  </nav>
 </div>
</header>
{% schema %}
{ "name":"Header", "settings":[] }
{% endschema %}