<style>
.home-hero{padding-top:clamp(28px,4vw,56px);padding-bottom:clamp(48px,6vw,82px)}
.home-hero__slot{display:block;position:relative;width:100%;aspect-ratio:16/7;min-height:230px;max-height:680px;overflow:hidden;background:rgba(245,248,241,.025);border:1px solid rgba(245,248,241,.08);text-decoration:none}
.home-hero__slot video,.home-hero__slot img{display:block;width:100%;height:100%;object-fit:cover}
.home-hero__slot video{position:absolute;inset:0}
.home-hero__slot--empty{background:transparent;border-color:transparent}
.home-products{padding-bottom:100px}
.home-products__top{display:flex;align-items:end;justify-content:space-between;gap:20px;margin-bottom:28px;border-bottom:1px solid rgba(245,248,241,.16);padding-bottom:18px}
.home-products__title{margin:0;font:400 clamp(30px,4vw,46px) Georgia,serif;letter-spacing:-.04em}
.home-products__link{color:#c7e5b6;font-size:11px;letter-spacing:.12em;text-transform:uppercase;text-decoration:none}
.home-product-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:42px 28px}
.home-product{display:block;min-width:0;text-decoration:none}
.home-product__media{position:relative;display:flex;align-items:center;justify-content:center;aspect-ratio:.82;overflow:hidden;background:transparent}
.home-product__media img,.home-product__media video{display:block;width:100%;height:100%;object-fit:contain;transition:transform .55s cubic-bezier(.2,.7,.2,1)}
.home-product:hover .home-product__media img,.home-product:hover .home-product__media video{transform:scale(1.045) translateY(-5px)}
.home-product__meta{display:flex;align-items:start;justify-content:space-between;gap:12px;padding-top:16px;border-top:1px solid rgba(245,248,241,.15)}
.home-product__name{margin:0;font-size:13px;line-height:1.5;font-weight:500}
.home-product__price{flex-shrink:0;color:#c7e5b6;font-size:12px}
.home-empty{padding:54px 0;color:rgba(245,248,241,.65);border-top:1px solid rgba(245,248,241,.15)}
@media(max-width:900px){.home-product-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:36px 18px}.home-hero__slot{aspect-ratio:4/3;min-height:190px}}
@media(max-width:480px){.home-product__meta{display:block}.home-product__price{display:block;margin-top:5px}}
</style>
<section class="page-width home-hero">
 {% if section.settings.hero_video != blank and section.settings.hero_product != blank %}
  <a class="home-hero__slot" href="{{ section.settings.hero_product.url }}" aria-label="Shop {{ section.settings.hero_product.title | escape }}">
   {{ section.settings.hero_video | video_tag: autoplay: true, loop: true, muted: true, controls: false, playsinline: true, preload: 'metadata' }}
  </a>
 {% elsif section.settings.hero_video != blank %}
  <div class="home-hero__slot">
   {{ section.settings.hero_video | video_tag: autoplay: true, loop: true, muted: true, controls: false, playsinline: true, preload: 'metadata' }}
  </div>
 {% else %}
  <div class="home-hero__slot home-hero__slot--empty" aria-hidden="true"></div>
 {% endif %}
</section>
{% assign featured_collection = collections['featured-products'] %}
<section class="page-width home-products">
 <div class="home-products__top"><h2 class="home-products__title">{{ section.settings.collection_heading | escape }}</h2><a class="home-products__link" href="{{ featured_collection.url }}">Explore collection ↗</a></div>
 {% if featured_collection != blank and featured_collection.products_count > 0 %}
  <div class="home-product-grid">
   {% for product in featured_collection.products limit: 8 %}
    <a class="home-product" href="{{ product.url }}">
     <div class="home-product__media">
      {% assign animated_media = product.media | where: 'media_type', 'video' | first %}
      {% if animated_media != blank %}
       {{ animated_media | media_tag: image_size: '1000x', autoplay: true, loop: true, muted: true, controls: false, preload: 'metadata' }}
      {% elsif product.featured_image %}
       {{ product.featured_image | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '360, 540, 720, 1000', sizes: '(min-width: 901px) 24vw, 46vw', alt: product.featured_image.alt | default: product.title }}
      {% endif %}
     </div>
     <div class="home-product__meta"><h3 class="home-product__name">{{ product.title | escape }}</h3><span class="home-product__price">{{ product.price | money }}</span></div>
    </a>
   {% endfor %}
  </div>
 {% else %}<div class="home-empty">Your featured products will appear here once you add them.</div>{% endif %}
</section>
{% schema %}
{
 "name":"Main homepage",
 "settings":[
  {"type":"video","id":"hero_video","label":"Featured banner video"},
  {"type":"product","id":"hero_product","label":"Product opened when banner is tapped"},
  {"type":"text","id":"collection_heading","label":"Featured products heading","default":"Featured products"}
 ],
 "presets":[{"name":"Main homepage"}]
}
{% endschema %}