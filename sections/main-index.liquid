<section class="page-width" style="padding-top:72px;padding-bottom:32px;">
  {% if section.settings.eyebrow != blank %}
    <p style="font-size:12px;letter-spacing:.14em;text-transform:uppercase;color:#777;">{{ section.settings.eyebrow | escape }}</p>
  {% endif %}
  <h1 style="max-width:780px;margin:12px 0 18px;font-size:clamp(40px,7vw,76px);line-height:.98;letter-spacing:-.06em;">{{ section.settings.heading | escape }}</h1>
  {% if section.settings.description != blank %}
    <div style="max-width:560px;font-size:17px;line-height:1.6;color:#666;">{{ section.settings.description }}</div>
  {% endif %}
  {% if section.settings.button_label != blank %}
    <a class="button" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}" style="margin-top:24px;">{{ section.settings.button_label | escape }}</a>
  {% endif %}
  {% assign featured_collection = section.settings.collection %}
  {% if featured_collection != blank and featured_collection.products_count > 0 %}
    <div style="display:flex;justify-content:space-between;align-items:end;margin-top:76px;margin-bottom:22px;">
      <h2 style="font-size:26px;letter-spacing:-.04em;margin:0;">{{ section.settings.collection_heading | escape }}</h2>
      <a href="{{ featured_collection.url }}" style="font-size:13px;">View all</a>
    </div>
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:24px;">
      {% for product in featured_collection.products limit: 4 %}
        <a href="{{ product.url }}" style="text-decoration:none;">
          <div style="background:#f5f5f5;aspect-ratio:4/5;overflow:hidden;">
            {% if product.featured_image %}
              {{ product.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', style: 'width:100%;height:100%;object-fit:cover;' }}
            {% endif %}
          </div>
          <h3 style="font-size:15px;margin:12px 0 5px;">{{ product.title | escape }}</h3>
          <span style="font-size:14px;color:#555;">{{ product.price | money }}</span>
        </a>
      {% endfor %}
    </div>
  {% endif %}
</section>
{% schema %}
{
  "name": "Main homepage",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small heading", "default": "A considered collection" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Find your next favourite." },
    { "type": "richtext", "id": "description", "label": "Description", "default": "<p>Thoughtfully selected pieces, made to fit your everyday.</p>" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop all" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "collection", "id": "collection", "label": "Featured collection" },
    { "type": "text", "id": "collection_heading", "label": "Collection heading", "default": "Featured products" }
  ],
  "presets": [{ "name": "Main homepage" }]
}
{% endschema %}
