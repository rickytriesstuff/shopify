<style>
.home-hero{padding-top:clamp(22px,3vw,42px);padding-bottom:clamp(34px,4vw,58px)}
.home-hero__grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px}
.home-hero__slot{display:block;position:relative;width:100%;aspect-ratio:16/9;overflow:hidden;background:rgba(245,248,241,.035);border:1px solid rgba(245,248,241,.1);text-decoration:none}
.home-hero__slot video,.home-hero__slot img{display:block;width:100%;height:100%;object-fit:cover}
.home-hero__slot video{position:absolute;inset:0}
.home-hero__slot-label{position:absolute;left:0;right:0;bottom:0;padding:28px 14px 12px;color:#fff;font-size:13px;font-weight:600;letter-spacing:.04em;background:linear-gradient(transparent,rgba(0,0,0,.72))}
.home-products{padding-bottom:80px}
.home-products__top{display:flex;align-items:end;justify-content:space-between;gap:20px;margin-bottom:24px;border-bottom:1px solid rgba(245,248,241,.16);padding-bottom:16px}
.home-products__title{margin:0;font:400 clamp(27px,3.5vw,42px) Georgia,serif;letter-spacing:-.04em}
.home-products__link{color:#c7e5b6;font-size:11px;letter-spacing:.12em;text-transform:uppercase;text-decoration:none}
.home-product-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:32px 22px}
.home-product{display:block;min-width:0;text-decoration:none}
.home-product__media{position:relative;display:flex;align-items:center;justify-content:center;aspect-ratio:.9;max-height:390px;overflow:hidden;background:transparent}
.home-product__media img,.home-product__media video{display:block;width:100%;height:100%;object-fit:contain;transition:transform .45s ease}
.home-product:hover .home-product__media img,.home-product:hover .home-product__media video{transform:scale(1.035)}
.home-product__meta{display:flex;flex-direction:column;align-items:flex-start;gap:6px;padding-top:12px;border-top:1px solid rgba(245,248,241,.2)}
.home-product__name{margin:0;font-size:13px;line-height:1.45;font-weight:500}
.home-product__price{display:block;color:#d8f0c9;font-size:14px;font-weight:700;line-height:1.3;letter-spacing:.01em}
.home-empty{padding:44px 0;color:rgba(245,248,241,.65);border-top:1px solid rgba(245,248,241,.15)}
@media(max-width:900px){.home-product-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:25px 14px}.home-hero__grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}.home-product__media{aspect-ratio:.95;max-height:250px}}
@media(max-width:480px){.home-hero{padding-top:18px;padding-bottom:28px}.home-products{padding-bottom:58px}.home-products__top{margin-bottom:18px}.home-product-grid{gap:22px 12px}.home-product__name{font-size:12px}.home-product__price{font-size:14px}}
</style>
<section class="page-width home-hero">
 <div class="home-hero__grid">
  {% for i in (1..6) %}
   {% assign video_key = 'hero_video_' | append: i %}
   {% assign collection_key = 'hero_collection_' | append: i %}
   {% assign hero_video = section.settings[video_key] %}
   {% assign hero_collection = section.settings[collection_key] %}
   {% if hero_video != blank %}
    {% if hero_collection != blank %}
     <a class="home-hero__slot" href="{{ hero_collection.url }}" aria-label="Shop {{ hero_collection.title | escape }}">
      {{ hero_video | video_tag: autoplay: true, loop: true, muted: true, controls: false, playsinline: true, preload: 'metadata' }}
      <span class="home-hero__slot-label">{{ hero_collection.title | escape }}</span>
     </a>
    {% else %}
     <div class="home-hero__slot">
      {{ hero_video | video_tag: autoplay: true, loop: true, muted: true, controls: false, playsinline: true, preload: 'metadata' }}
     </div>
    {% endif %}
   {% endif %}
  {% endfor %}
 </div>
</section>
{% assign featured_collection = collections['featured-products'] %}
<section class="page-width home-products">
 <div class="home-products__top"><h2 class="home-products__title">{{ section.settings.collection_heading | escape }}</h2><a class="home-products__link" href="{{ featured_collection.url }}">Explore collection ↗</a></div>
 {% if featured_collection != blank and featured_collection.products_count > 0 %}
  <div class="home-product-grid">
   {% for product in featured_collection.products limit: 8 %}
    <a class="home-product" href="{{ product.url }}">
     <div class="home-product__media">
      {% assign animated_media = product.media | where: 'media_type', 'video' | first %}
      {% if animated_media != blank %}
       {{ animated_media | media_tag: image_size: '800x', autoplay: true, loop: true, muted: true, controls: false, preload: 'metadata' }}
      {% elsif product.featured_image %}
       {{ product.featured_image | image_url: width: 800 | image_tag: loading: 'lazy', widths: '320, 480, 640, 800', sizes: '(min-width: 901px) 24vw, 47vw', alt: product.featured_image.alt | default: product.title }}
      {% endif %}
     </div>
     <div class="home-product__meta"><h3 class="home-product__name">{{ product.title | escape }}</h3><span class="home-product__price">{{ product.price | money }}</span></div>
    </a>
   {% endfor %}
  </div>
 {% else %}<div class="home-empty">Your featured products will appear here once you add them.</div>{% endif %}
</section>
{% schema %}
{
 "name":"Main homepage",
 "settings":[
  {"type":"header","content":"Category video banners"},
  {"type":"video","id":"hero_video_1","label":"Video slot 1"},
  {"type":"collection","id":"hero_collection_1","label":"Category for video 1"},
  {"type":"video","id":"hero_video_2","label":"Video slot 2"},
  {"type":"collection","id":"hero_collection_2","label":"Category for video 2"},
  {"type":"video","id":"hero_video_3","label":"Video slot 3"},
  {"type":"collection","id":"hero_collection_3","label":"Category for video 3"},
  {"type":"video","id":"hero_video_4","label":"Video slot 4"},
  {"type":"collection","id":"hero_collection_4","label":"Category for video 4"},
  {"type":"video","id":"hero_video_5","label":"Video slot 5"},
  {"type":"collection","id":"hero_collection_5","label":"Category for video 5"},
  {"type":"video","id":"hero_video_6","label":"Video slot 6"},
  {"type":"collection","id":"hero_collection_6","label":"Category for video 6"},
  {"type":"header","content":"Featured products"},
  {"type":"text","id":"collection_heading","label":"Featured products heading","default":"Featured products"}
 ],
 "presets":[{"name":"Main homepage"}]
}
{% endschema %}