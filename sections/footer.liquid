<style>
.site-footer{margin-top:50px;padding:42px 0 26px;background:#050505;color:#fff}
.site-footer__inner{display:grid;grid-template-columns:1.2fr 1fr;gap:28px;align-items:start}
.site-footer__brand{color:#fff;font-family:Georgia,serif;font-size:24px}
.site-footer__copy{grid-column:1/-1;border-top:1px solid rgba(255,255,255,.18);padding-top:20px;color:rgba(255,255,255,.72);font-size:11px;letter-spacing:.04em}
.site-footer__payments h2{margin:0 0 12px;color:#fff;font-size:13px;font-weight:700}
.site-footer__payment-icons{display:flex;flex-wrap:wrap;align-items:center;gap:8px;margin-bottom:10px}
.site-footer__payment-icons svg{height:25px;width:auto;max-width:48px;background:#fff;border-radius:4px;padding:2px}
.site-footer__payment-names{display:flex;flex-wrap:wrap;gap:7px;color:rgba(255,255,255,.78);font-size:11px;text-transform:capitalize}
.site-footer__payment-names span{border:1px solid rgba(255,255,255,.24);border-radius:4px;padding:5px 8px}
@media(max-width:600px){.site-footer{padding:32px 0 22px}.site-footer__inner{grid-template-columns:1fr;gap:22px}.site-footer__copy{grid-column:auto}}
</style>
<footer class="site-footer">
 <div class="page-width site-footer__inner">
  <div><span class="site-footer__brand">{{ shop.name }}</span></div>
  <section class="site-footer__payments" aria-label="Accepted payment methods">
   <h2>We accept</h2>
   {% if shop.enabled_payment_types.size > 0 %}
    <div class="site-footer__payment-icons">
     {% for type in shop.enabled_payment_types %}{{ type | payment_type_svg_tag: class: 'payment-icon' }}{% endfor %}
    </div>
    <div class="site-footer__payment-names">
     {% for type in shop.enabled_payment_types %}<span>{{ type | replace: '_', ' ' | replace: '-', ' ' }}</span>{% endfor %}
    </div>
   {% else %}
    <p class="site-footer__payment-names">Available payment methods are displayed securely at checkout.</p>
   {% endif %}
  </section>
  <div class="site-footer__copy">© {{ 'now' | date: '%Y' }} {{ shop.name }}. ALL RIGHTS RESERVED.</div>
 </div>
</footer>
{% schema %}
{ "name": "Footer", "settings": [] }
{% endschema %}