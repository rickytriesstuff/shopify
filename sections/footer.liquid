<style>
  .site-footer { margin-top:50px; padding:34px 0; border-top:1px solid rgba(245,248,241,.14); }
  .site-footer__inner { display:flex; align-items:center; justify-content:space-between; gap:20px; flex-wrap:wrap; }
  .site-footer__brand { color:#f5f8f1; font-family:Georgia,serif; font-size:20px; }
  .site-footer__copy { color:rgba(245,248,241,.55); font-size:10px; letter-spacing:.08em; }
</style>
<footer class="site-footer">
  <div class="page-width site-footer__inner">
    <span class="site-footer__brand">{{ shop.name }}</span>
    <span class="site-footer__copy">© {{ 'now' | date: '%Y' }} {{ shop.name }}. ALL RIGHTS RESERVED.</span>
  </div>
</footer>
{% schema %}
{ "name": "Footer", "settings": [] }
{% endschema %}