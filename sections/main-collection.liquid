<style>
.collection-page{padding-top:clamp(55px,8vw,105px);padding-bottom:100px}
.collection-head{padding-bottom:30px;border-bottom:1px solid rgba(245,248,241,.16);margin-bottom:34px}
.collection-head__eyebrow{color:#c7e5b6;font-size:10px;letter-spacing:.2em;text-transform:uppercase}
.collection-head h1{font:400 clamp(42px,7vw,82px)/1 Georgia,serif;letter-spacing:-.055em;margin:16px 0}
.collection-head__description{max-width:620px;color:rgba(245,248,241,.65);font-size:14px;line-height:1.8}
.collection-tools{display:flex;justify-content:space-between;align-items:center;gap:20px;margin-bottom:25px;color:rgba(245,248,241,.62);font-size:11px}
.collection-tools select{background:transparent;color:#f5f8f1;border:1px solid rgba(245,248,241,.25);padding:10px 12px}
.collection-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:42px 26px}
.collection-card{color:inherit;text-decoration:none;min-width:0}
.collection-card__media{aspect-ratio:.82;display:flex;align-items:center;justify-content:center;overflow:hidden;background:transparent}
.collection-card__media img{width:100%;height:100%;object-fit:contain;transition:transform .5s ease}
.collection-card:hover img{transform:scale(1.04)}
.collection-card__info{display:flex;justify-content:space-between;gap:12px;border-top:1px solid rgba(245,248,241,.15);padding-top:14px}
.collection-card__title{font-size:13px;margin:0;line-height:1.5}
.collection-card__price{color:#c7e5b6;font-size:12px;white-space:nowrap}
.collection-empty{padding:55px 0;color:rgba(245,248,241,.65)}
@media(max-width:900px){.collection-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:35px 16px}}
</style>
<section class="page-width collection-page">
 <header class="collection-head">
  <p class="collection-head__eyebrow">THE COLLECTION</p>
  <h1>{{ collection.title | escape }}</h1>
  {% if collection.description != blank %}<div class="collection-head__description">{{ collection.description }}</div>{% endif %}
 </header>
 <div class="collection-tools"><span>{{ collection.products_count }} pieces</span>
  <form method="get"><label for="SortBy" class="visually-hidden">Sort by</label><select name="sort_by" id="SortBy" onchange="this.form.submit()">
   {% for option in collection.sort_options %}<option value="{{ option.value }}" {% if option.value == collection.sort_by %}selected{% endif %}>{{ option.name }}</option>{% endfor %}
  </select></form>
 </div>
 {% paginate collection.products by 24 %}
  {% if collection.products_count > 0 %}
   <div class="collection-grid">
    {% for product in collection.products %}
     <a class="collection-card" href="{{ product.url }}">
      <div class="collection-card__media">{% if product.featured_image %}{{ product.featured_image | image_url: width: 900 | image_tag: loading:'lazy', widths:'360,540,720,900', alt:product.featured_image.alt | default:product.title }}{% endif %}</div>
      <div class="collection-card__info"><h2 class="collection-card__title">{{ product.title | escape }}</h2><span class="collection-card__price">{{ product.price | money }}</span></div>
     </a>
    {% endfor %}
   </div>
  {% else %}<div class="collection-empty">This collection is being curated. Check back soon for new pieces.</div>{% endif %}
  {% if paginate.pages > 1 %}<nav class="pagination" role="navigation" aria-label="Pagination">{% if paginate.previous %}<a href="{{ paginate.previous.url }}">← Previous</a>{% endif %}<span>Page {{ paginate.current_page }} of {{ paginate.pages }}</span>{% if paginate.next %}<a href="{{ paginate.next.url }}">Next →</a>{% endif %}</nav>{% endif %}
 {% endpaginate %}
</section>
{% schema %}
{"name":"Collection page","settings":[]}
{% endschema %}