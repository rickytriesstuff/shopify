<style>
.collection-page{padding-top:clamp(42px,6vw,82px);padding-bottom:80px;color:#111}
.collection-head{padding-bottom:24px;border-bottom:1px solid #e5e7eb;margin-bottom:26px}
.collection-head__eyebrow{color:#2563eb;font-size:10px;letter-spacing:.2em;text-transform:uppercase;font-weight:700}
.collection-head h1{color:#111;font:400 clamp(36px,6vw,72px)/1 Georgia,serif;letter-spacing:-.055em;margin:13px 0}
.collection-head__description{max-width:620px;color:#444;font-size:14px;line-height:1.8}
.collection-tools{display:flex;justify-content:space-between;align-items:center;gap:20px;margin-bottom:20px;color:#333;font-size:12px}
.collection-tools select{background:#fff;color:#111;border:1px solid #cbd5e1;border-radius:6px;padding:10px 12px;max-width:170px}
.collection-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:32px 22px}
.collection-card{color:#111;text-decoration:none;min-width:0}
.collection-card__media{aspect-ratio:.9;max-height:390px;display:flex;align-items:center;justify-content:center;overflow:hidden;background:#fff}
.collection-card__media img{width:100%;height:100%;object-fit:contain;transition:transform .45s ease}
.collection-card:hover img{transform:scale(1.035)}
.collection-card__info{display:flex;flex-direction:column;align-items:flex-start;gap:6px;border-top:1px solid #e5e7eb;padding-top:12px}
.collection-card__title{color:#111;font-size:13px;margin:0;line-height:1.45;font-weight:600}
.collection-card__price{display:block;color:#111;font-size:15px;font-weight:800;line-height:1.3;white-space:nowrap}
.collection-empty{padding:45px 0;color:#444}
.pagination{display:flex;justify-content:center;gap:22px;padding:34px 0;color:#2563eb;font-size:13px}
@media(max-width:900px){.collection-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:25px 14px}.collection-card__media{aspect-ratio:.95;max-height:250px}}
@media(max-width:480px){.collection-page{padding-top:34px;padding-bottom:55px}.collection-head{margin-bottom:20px}.collection-head h1{font-size:38px}.collection-tools{font-size:11px}.collection-grid{gap:22px 12px}.collection-card__title{font-size:12px}.collection-card__price{font-size:14px}}
</style>
<section class="page-width collection-page">
 <header class="collection-head">
  <p class="collection-head__eyebrow">THE COLLECTION</p>
  <h1>{{ collection.title | escape }}</h1>
  {% if collection.description != blank %}<div class="collection-head__description">{{ collection.description }}</div>{% endif %}
 </header>
 <div class="collection-tools"><span>{{ collection.products_count }} pieces</span>
  <form method="get"><label for="SortBy" class="visually-hidden">Sort by</label><select name="sort_by" id="SortBy" onchange="this.form.submit()">
   {% for option in collection.sort_options %}<option value="{{ option.value }}" {% if option.value == collection.sort_by %}selected{% endif %}>{{ option.name }}</option>{% endfor %}
  </select></form>
 </div>
 {% paginate collection.products by 24 %}
  {% if collection.products_count > 0 %}
   <div class="collection-grid">
    {% for product in collection.products %}
     <a class="collection-card" href="{{ product.url }}">
      <div class="collection-card__media">{% if product.featured_image %}{{ product.featured_image | image_url: width: 800 | image_tag: loading:'lazy', widths:'320,480,640,800', sizes:'(min-width: 901px) 24vw, 47vw', alt:product.featured_image.alt | default:product.title }}{% endif %}</div>
      <div class="collection-card__info"><h2 class="collection-card__title">{{ product.title | escape }}</h2><span class="collection-card__price">{{ product.price | money }}</span></div>
     </a>
    {% endfor %}
   </div>
  {% else %}<div class="collection-empty">This collection is being curated. Check back soon for new pieces.</div>{% endif %}
  {% if paginate.pages > 1 %}<nav class="pagination" role="navigation" aria-label="Pagination">{% if paginate.previous %}<a href="{{ paginate.previous.url }}">← Previous</a>{% endif %}<span>Page {{ paginate.current_page }} of {{ paginate.pages }}</span>{% if paginate.next %}<a href="{{ paginate.next.url }}">Next →</a>{% endif %}</nav>{% endif %}
 {% endpaginate %}
</section>
{% schema %}
{"name":"Collection page","settings":[]}
{% endschema %}